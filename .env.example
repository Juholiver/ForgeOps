# Copy this file to `.env` for local development (never commit .env).

# Base URL of the ForgeOps API used by the app at build/run time.
# - Local dev: point directly to the backend (CORS already allows
#   http://localhost:3000, see backend CORS_ORIGINS).
# - Production: set the full backend URL, e.g. https://api.example.com
VITE_API_URL=http://localhost:8000
