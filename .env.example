# Copy this file to `.env` for local development (never commit .env).

# Base URL of the ForgeOps API used by the app at build/run time.
# - Local dev and the bundled Docker image use the same-origin /api path,
#   proxied by the Vite dev server (dev) or nginx.conf (container).
# - Cross-origin deployments: set the full URL, e.g. https://api.example.com
VITE_API_URL=/api

# Target of the Vite dev-server /api proxy (required by `npm run dev`).
# Points to a locally running backend (see forgeops-frontend README).
VITE_DEV_PROXY_TARGET=http://localhost:8000
